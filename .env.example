# Copy this file to .env.local and fill in your Azure resource values.
# Never commit .env.local — it is listed in .gitignore.
#
# All backend services authenticate via DefaultAzureCredential.
# Run `az login` inside the dev container, or provide a service principal below.

# ── Azure Storage ─────────────────────────────────────────────────────────────
AZURE__BlobStorageAccountUrl=https://<storage-account>.blob.core.windows.net
AZURE__QueueStorageAccountUrl=https://<storage-account>.queue.core.windows.net

# ── Azure Cosmos DB (NoSQL API) ───────────────────────────────────────────────
AZURE__CosmosEndpoint=https://<cosmos-account>.documents.azure.com:443/
AZURE__CosmosDatabaseName=claims-intelligence

# ── Azure AI Content Understanding ────────────────────────────────────────────
AZURE__ContentUnderstanding__Endpoint=https://<cu-resource>.cognitiveservices.azure.com

# ── Azure AI Inference (Foundry) ──────────────────────────────────────────────
AZURE__AzureInferenceEndpoint=https://<project>.inference.ml.azure.com
AZURE__AzureOpenAiModel=gpt-4.1

# ── Azure App Configuration ───────────────────────────────────────────────────
AZURE__AppConfigurationEndpoint=https://<appconfig>.azconfig.io

# ── Azure Monitor / Application Insights ─────────────────────────────────────
AZURE__ApplicationInsightsConnectionString=InstrumentationKey=<key>;IngestionEndpoint=https://eastus-8.in.applicationinsights.azure.com/

# ── ContentProcessor worker settings ─────────────────────────────────────────
ContentProcessor__ProcessesContainer=processes
ContentProcessor__MaxRetryAttempts=5
ContentProcessor__RetryBaseDelaySeconds=2

# ── Workflow worker settings ──────────────────────────────────────────────────
Workflow__InferenceModelName=gpt-4.1
Workflow__DocumentPollIntervalSeconds=10
Workflow__DocumentPollTimeoutSeconds=300
Workflow__RaiEnabled=true

# ── API settings ──────────────────────────────────────────────────────────────
Api__MaxFileSizeMb=20

# ── Optional: service principal for local dev (if not using az login) ─────────
# AZURE_TENANT_ID=<tenant-id>
# AZURE_CLIENT_ID=<client-id>
# AZURE_CLIENT_SECRET=<client-secret>
