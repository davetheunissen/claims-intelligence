<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ClaimsIntelligence.Workflow</RootNamespace>
    <AssemblyName>ClaimsIntelligence.Workflow</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Polly.Extensions" Version="8.5.2" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaimsIntelligence.Domain\ClaimsIntelligence.Domain.csproj" />
    <ProjectReference Include="..\ClaimsIntelligence.Infrastructure\ClaimsIntelligence.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy YAML gap-rule files to output directory -->
    <None Update="GapRules\*.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
